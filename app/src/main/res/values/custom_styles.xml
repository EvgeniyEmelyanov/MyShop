<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.App" parent="Theme.MaterialComponents" />

    <!--Buttons styles!-->

    <!-- Add button for product items in the cart -->
    <style name="Widget.App.IconButton.Add" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">@color/brand_green</item>
        <item name="cornerRadius">17dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Confirm button for cart, favorite, account sections -->
    <style name="Widget.App.Button.Confirm" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">67dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="cornerRadius">19dp</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
    </style>

    <style name="Widget.App.Button.LogOut" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">67dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="cornerRadius">19dp</item>
        <item name="backgroundTint">@color/button_secondary_bg</item>
    </style>

    <style name="Widget.App.Filter.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:button">@null</item>
        <item name="android:drawableStart">@drawable/selector_filter_checkbox</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textColor">@color/filter_checkbox_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Text style for the confirm button -->
    <style name="TextAppearance.ConfirmBotton.CheckoutButtonText" parent="Widget.AppCompat.TextView">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
    </style>

    <style name="Widget.App.IconButton.Back" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_back_to_first_fragment</item>
    </style>

    <style name="Widget.App.IconButton.Share" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_share</item>
    </style>

    <style name="Widget.App.IconButton.Filter" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_filter</item>
    </style>

    <style name="Widget.App.IconButton.CloseFilter" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_close_filter</item>
    </style>

    <style name="Widget.App.IconButton.Arrow" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_back_arrow</item>
    </style>

    <style name="Widget.App.IconButton.Arrow2" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/ic_back_arrow</item>
    </style>


    <!-- Text style -->

    <!-- Text style for product title in card items -->
    <style name="TextAppearance.App.Card.ProductTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/gilroy_bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="lineHeight">18sp</item>
        <item name="android:gravity">start|center_horizontal</item>
    </style>

    <!-- Text style for product weight in card items -->
    <style name="TextAppearance.App.Card.ProductWeight.Small" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">18sp</item>
        <item name="android:gravity">start|center_horizontal</item>
    </style>

    <style name="TextAppearance.App.ProductWeight.Large" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
        <item name="android:gravity">start|center_horizontal</item>
        <item name="lineHeight">21sp</item>
    </style>

    <!-- Text style for product price in card items and fragments -->
    <style name="TextAppearance.App.ProductPrice" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">start|center_horizontal</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">18sp</item>
    </style>

    <!-- Count of products in card items and the FragmentProductDetail -->
    <style name="TextAppearance.App.NumberPicker" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="lineHeight">18sp</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <!-- Header of fragments -->
    <style name="TextAppearance.AppCompat.PageHeader" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Header of fragments -->
    <style name="TextAppearance.AppCompat.ProductHeaderGroup" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gilroy_bold</item>
        <item name="lineHeight">22sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- User name in FragmentAccount -->
    <style name="TextAppearance.UserName" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/gilroy_bold</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- User email in FragmentAccount -->
    <style name="TextAppearance.UserEmail" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Section title text style for FragmentExplore -->
    <style name="TextAppearance.Settings.SectionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
    </style>


    <!-- Text style for the shop fragment -->
    <!-- Section title text style for FragmentShop -->
    <style name="TextAppearance.SectionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:gravity">center|start</item>
    </style>

    <!-- Header of groceries card items -->
    <style name="TextAppearance.Card.HeaderOfGroceries" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:textColor">@color/text_groceries_cart_title</item>
    </style>


    <!-- Text style for the FragmentProductDetail -->
    <style name="TextAppearance.ProductName" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/gilroy_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="lineHeight">18sp</item>
    </style>

    <style name="TextAppearance.App.ProductTextDescription" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">start|center_horizontal</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">18sp</item>
    </style>

    <style name="TextAppearance.App.SectionHeader" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:gravity">start|center_horizontal</item>
        <item name="lineHeight">18sp</item>
    </style>

    <!-- Radius style for rounded corners -->
    <style name="RoundedStyle">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.App.OvalImage" parent="">
        <item name="cornerSize">30dp</item>
    </style>


    <!-- Styles for Containers -->
    <style name="Widget.App.ItemCardContainer">
        <item name="android:background">@drawable/bg_product_card</item>
        <item name="android:orientation">vertical</item>
    </style>


    <!-- Text style for bottom navigation icons and text -->
    <style name="TextAppearance.BottomNav.IconsText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
    </style>

    <style name="Theme.MyShop.UCrop" parent="Theme.AppCompat.Light.NoActionBar" />


</resources>
