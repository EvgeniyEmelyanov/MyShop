<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.IconButtonBackToFirstFragment" parent="Widget.MaterialComponents.Button.TextButton">
        <!-- Размер кликабельной зоны -->
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>

        <!-- Убираем лишние внутренние отступы MaterialButton -->
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>

        <!-- Фон прозрачный, но ripple будет -->
        <item name="backgroundTint">@android:color/transparent</item>

        <!-- Иконка без текста -->
        <item name="iconPadding">0dp</item>
    </style>


    <style name="bannerProductName" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/txt_product_name_price_description</item>
        <item name="android:fontFamily">@font/gilroy_bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="lineHeight">18sp</item>
        <item name="android:gravity">start|center_horizontal</item>
    </style>

    <style name="bannerProductWeight" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/txt_price_tag_text_description</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">18sp</item>
        <item name="android:gravity">start|center_horizontal</item>
    </style>

    <style name="TextAppearance.AppCompat.ProductWeight.FragmentProductDetail" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/txt_price_tag_text_description</item>
        <item name="android:fontFamily">@font/gilroy_medium</item>
        <item name="android:gravity">start|center_horizontal</item>
        <item name="lineHeight">21sp</item>
    </style>

    <style name="TextAppearance.AppCompat.ProductHeaderDescription.FragmentProductDetail" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/txt_product_name_price_description</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:gravity">start|center_horizontal</item>
        <item name="lineHeight">18sp</item>
    </style>

    <style name="TextAppearance.AppCompat.ProductPrice" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/txt_product_name_price_description</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">start|center_horizontal</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">18sp</item>
    </style>

    <style name="TextAppearance.AppCompat.ProductTextDescription.FragmentProductDetail" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/txt_product_name_price_description</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:gravity">start|center_horizontal</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">18sp</item>
    </style>

    <style name="Container_for_item_product_horizontal">
        <item name="android:background">@drawable/shape_rounded_for_products_banner</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="productContainer">
        <item name="android:background">@drawable/shape_rounded_for_products_banner</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Widget.IconButton.Add" parent="Widget.MaterialComponents.Button">
        <!-- Размер -->
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>

        <!-- Внешний вид -->
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>

        <!-- Цвет фона -->
        <item name="backgroundTint">@color/brand_green</item>

        <!-- Скругление (подгони под макет) -->
        <item name="cornerRadius">17dp</item>

        <!-- Иконка по центру -->
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>

        <!-- Цвет иконки -->
        <item name="iconTint">@android:color/white</item>

        <!-- Текст нам не нужен -->
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="TextAppearance.SectionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/txt_product_name_price_description</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:gravity">center|start</item>
    </style>

    <style name="TextAppearance.GroceriesTitle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:textColor">@color/title_for_item_groceries</item>
    </style>

    <style name="TextAppearance.GroceriesTitle.Fragment.Product.Detail" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/gilroy_bold</item>
        <item name="android:textColor">@color/txt_product_name_price_description</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="lineHeight">18sp</item>
    </style>

    <style name="BottomNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
    </style>

    <style name="TextAppearance.AppCompat.TitleForPage" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="lineHeight">18sp</item>
        <item name="android:textColor">@color/txt_product_header</item>
    </style>

    <style name="TextAppearance.AppCompat.TitleForExploreBanner" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gilroy_bold</item>
        <item name="lineHeight">22sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="btn_add_cart_banner" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_for_btn_cart_banner_add_decrease</item>
        <item name="android:padding">14dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="TextAppearance.AppCompat.ProductTitleForCartBanner" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/gilroy_bold</item>
        <item name="lineHeight">18sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>



    <style name="TextAppearance.AppCompat.NumberPicker" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/txt_product_name_price_description</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="lineHeight">18sp</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="btn_confirm_button" parent="Widget.Material3.Button">
        <item name="android:layout_height">67dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <!-- Текст -->
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/txt_color_for_confirm_button</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>

        <!-- Форма -->
        <item name="cornerRadius">19dp</item>

        <!-- Цвет -->
        <item name="backgroundTint">@color/bg_btn_confirm_button</item>
    </style>



    <style name="TextAppearance.Cart.CheckoutButtonText" parent="Widget.AppCompat.TextView">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/txt_color_for_confirm_button</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/gilroy_semibold</item>
    </style>


    <style name="Widget.App.IconButton.Back" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_back_to_first_fragment</item>
    </style>


    <style name="Widget.App.IconButton.Share" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_share</item>
    </style>

    <style name="Widget.App.IconButton.Filter" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_filter</item>
    </style>

    <style name="Widget.App.IconButton.Arrow" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">0dp</item>
        <item name="android:src">@drawable/ic_back_arrow</item>
    </style>





</resources>
