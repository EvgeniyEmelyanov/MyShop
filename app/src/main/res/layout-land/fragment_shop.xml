<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="15dp">


            <ImageView
                android:id="@+id/ivCarrot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="9dp"
                android:contentDescription="Carrot picture"
                android:src="@drawable/ic_carrot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:drawableStart="@drawable/ic_exclude"
                android:drawablePadding="5dp"
                android:fontFamily="@font/gilroy_black"
                android:text="Minsk, Belarus" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_search_field"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:fontFamily="@font/gilroy_semibold"
                android:hint="Search Store"
                android:paddingStart="15dp"
                android:textSize="14sp"
                tools:ignore="RtlSymmetry" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpBanners"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="15dp"
                tools:layout_height="110dp"
                tools:listitem="@layout/item_shop_banner">

            </androidx.viewpager2.widget.ViewPager2>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="21dp">

                <TextView
                    android:id="@+id/tvSeeAllFirst"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4.5dp"
                    android:layout_marginBottom="4.5dp"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center|end"
                    android:text="See all"
                    android:textColor="@color/text_tertiary"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvExclusiveOffer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <TextView
                    android:id="@+id/tvExclusiveOffer"
                    style="@style/TextAppearance.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Exclusive Offer"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvSeeAllFirst"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExclusiveOffer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_product_horizontal" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="21dp">

                <TextView
                    android:id="@+id/tvSeeAllSecond"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4.5dp"
                    android:layout_marginBottom="4.5dp"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center|end"
                    android:text="See all"
                    android:textColor="@color/text_tertiary"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvBestSelling"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <TextView
                    android:id="@+id/tvBestSelling"
                    style="@style/TextAppearance.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Best Selling"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvSeeAllSecond"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBestSellingProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_product_horizontal" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="21dp">

                <TextView
                    android:id="@+id/tvSeeAllThird"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4.5dp"
                    android:layout_marginBottom="4.5dp"
                    android:fontFamily="@font/gilroy_semibold"
                    android:gravity="center|end"
                    android:text="See all"
                    android:textColor="@color/text_tertiary"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tvGroceries"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

                <TextView
                    android:id="@+id/tvGroceries"
                    style="@style/TextAppearance.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Groceries"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvSeeAllThird"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGroceries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_grocery_category" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGroceriesProductCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_product_horizontal" />


        </LinearLayout>


    </androidx.core.widget.NestedScrollView>
</FrameLayout>
