<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/bnt_AddToCart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvReview"
                style="@style/TextAppearance.App.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/review"
                app:layout_constraintBottom_toBottomOf="@+id/back_arrow2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/back_arrow2"
                app:layout_constraintVertical_bias="0.611" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clHeaderImage"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:background="@drawable/bg_product_detail_image"
                android:backgroundTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_picture"
                    android:contentDescription="@null"
                    android:layout_width="215dp"
                    android:layout_height="189dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/img_product_banana" />

                <ImageButton
                    android:id="@+id/btnShare"
                    style="@style/Widget.App.IconButton.Share"
                    android:contentDescription="@string/cd_share_product"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/btnBackToFirstFragment"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/btnBackToFirstFragment"
                    app:layout_constraintVertical_bias="0.0" />


                <ImageButton
                    android:id="@+id/btnBackToFirstFragment"
                    style="@style/Widget.App.IconButton.Back"
                    android:contentDescription="@string/cd_back"
                    android:layout_marginStart="6dp"
                    app:layout_constraintEnd_toStartOf="@+id/btnShare"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvProductTitle"
                style="@style/TextAppearance.ProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="25dp"
                app:layout_constraintEnd_toStartOf="@id/btnAddToFavorite"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clHeaderImage"
                tools:text="Name product" />

            <ImageButton
                android:id="@+id/btnAddToFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_add_to_favourite"
                android:focusable="true"
                android:padding="15dp"
                android:src="@drawable/ic_favourite_outline"
                app:layout_constraintBottom_toBottomOf="@id/tvProductTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvProductTitle" />

            <TextView
                android:id="@+id/tvProductWeight"
                style="@style/TextAppearance.App.ProductWeight.Large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tvProductTitle"
                app:layout_constraintTop_toBottomOf="@id/tvProductTitle"
                tools:text="Weight product" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnProductDecrease"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_decrease_quantity"
                android:focusable="true"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_quantity_decrease"
                app:layout_constraintStart_toStartOf="@id/tvProductWeight"
                app:layout_constraintTop_toBottomOf="@id/tvProductWeight" />

            <TextView
                android:id="@+id/tvProductCount"
                style="@style/TextAppearance.App.NumberPicker"
                android:layout_width="100dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_cart_quantity_button"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/default_product_count"
                app:layout_constraintBottom_toBottomOf="@id/btnProductDecrease"
                app:layout_constraintStart_toEndOf="@id/btnProductDecrease"
                app:layout_constraintTop_toTopOf="@id/btnProductDecrease" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnProductIncrease"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_increase_quantity"
                android:focusable="true"
                android:padding="0dp"
                android:scaleType="center"
                android:src="@drawable/ic_quantity_increase"
                app:layout_constraintBottom_toBottomOf="@id/btnProductDecrease"
                app:layout_constraintStart_toEndOf="@id/tvProductCount"
                app:layout_constraintTop_toTopOf="@id/btnProductDecrease" />

            <TextView
                android:id="@+id/tvProductPrice"
                style="@style/TextAppearance.App.ProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="@id/btnProductIncrease"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnProductIncrease"
                tools:text="$4.99" />

            <View
                android:id="@+id/firstLine"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="30dp"
                android:background="@color/divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnProductDecrease" />

            <TextView
                android:id="@+id/tvProductDetailHeader"
                style="@style/TextAppearance.App.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="@string/product_detail"
                app:layout_constraintBottom_toBottomOf="@+id/btnToggleDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnToggleDescription" />

            <ImageButton
                android:id="@+id/btnToggleDescription"
                style="@style/Widget.App.IconButton.Arrow"
                android:contentDescription="@string/cd_toggle_product_description"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/firstLine" />

            <TextView
                android:id="@+id/tvProductDescription"
                style="@style/TextAppearance.App.ProductWeight.Large"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:justificationMode="inter_word"
                android:lineSpacingExtra="4dp"
                android:paddingHorizontal="25dp"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textIsSelectable="true"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvProductDetailHeader"
                tools:text="Apples are nutritious. Apples may be good for weight loss. Apples may be good for your heart. As part of a healthful and varied diet." />

            <View
                android:id="@+id/secondLine"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="19dp"
                android:background="@color/divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvProductDescription" />

            <TextView
                android:id="@+id/tvNutrition"
                style="@style/TextAppearance.App.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:text="@string/nutrition"
                app:layout_constraintBottom_toBottomOf="@+id/btnBackArrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btnBackArrow" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNutritionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/background_cardNutritionValue"
                app:cardCornerRadius="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/btnBackArrow"
                app:layout_constraintEnd_toStartOf="@+id/btnBackArrow"
                app:layout_constraintTop_toTopOf="@+id/btnBackArrow"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvNutrition1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="4dp"
                    android:text="@string/nutrition_value_100g" />

            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/btnBackArrow"
                style="@style/Widget.App.IconButton.Arrow"
                android:contentDescription="@string/cd_toggle_nutrition"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toTopOf="@id/thirdLine"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/secondLine" />

            <View
                android:id="@+id/thirdLine"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="25dp"
                android:background="@color/divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnBackArrow" />

            <LinearLayout
                android:id="@+id/layoutStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@drawable/divider_5dp"
                android:orientation="horizontal"
                android:showDividers="middle"
                app:layout_constraintBottom_toBottomOf="@id/back_arrow2"
                app:layout_constraintEnd_toStartOf="@+id/back_arrow2"
                app:layout_constraintTop_toTopOf="@+id/back_arrow2">

                <ImageButton
                    android:id="@+id/btn_star1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_star"
                    android:contentDescription="@string/cd_rating_star" />

                <ImageButton
                    android:id="@+id/btn_star2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_star"
                    android:contentDescription="@string/cd_rating_star" />

                <ImageButton
                    android:id="@+id/btn_star3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_star"
                    android:contentDescription="@string/cd_rating_star" />

                <ImageButton
                    android:id="@+id/btn_star4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_star"
                    android:contentDescription="@string/cd_rating_star" />

                <ImageButton
                    android:id="@+id/btn_star5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_star"
                    android:contentDescription="@string/cd_rating_star" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/back_arrow2"
                style="@style/Widget.App.IconButton.Arrow"
                android:contentDescription="@string/cd_open_product_details"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toTopOf="@+id/bottomAnchor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/thirdLine"
                app:layout_constraintVertical_bias="0.0" />

            <View
                android:id="@+id/bottomAnchor"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/back_arrow2" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bnt_AddToCart"
        style="@style/Widget.App.Button.Confirm"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:layout_marginHorizontal="25dp"
        android:layout_marginBottom="10dp"
        android:text="@string/add_to_basket"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>


