<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_marginVertical="30dp"
    tools:layout_marginTop="50dp">


    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"

            tools:layout_editor_absoluteX="11dp"
            tools:layout_editor_absoluteY="3dp"
            tools:layout_height="65dp"
            tools:layout_width="70dp"
            tools:src="@drawable/apple_picture" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="27dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/linearLayout3"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvProductTitle"
            style="@style/TextAppearance.AppCompat.ProductTitleForCartBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center|top"
            android:text="Bell Peper Red"
            app:layout_constraintBottom_toTopOf="@+id/btnProductDecrease"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvProductWeight"
            style="@style/bannerProductWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1kg,Price" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/linearLayout"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <ImageButton
            android:id="@+id/btnProductDecrease"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_for_btn_cart_banner_add_decrease"
            android:scaleType="centerInside"
            android:src="@drawable/ic_decrease_for_btn"
            tools:ignore="MissingConstraints" />

        <TextView
            android:id="@+id/tvProductCount"
            style="@style/TextAppearance.AppCompat.NumberPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="17dp"
            android:layout_marginEnd="17dp"
            android:text="1" />

        <ImageButton
            android:id="@+id/btnProductAdd"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_for_btn_cart_banner_add_decrease"
            android:padding="0dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add_for_btn_green" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvProductPrice"
            style="@style/bannerProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:text="$4.99" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>