<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.ItemCardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivProductPicture"
        android:layout_width="105dp"
        android:layout_height="65dp"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:contentDescription="@null"
        tools:srcCompat="@drawable/img_product_apple" />

    <TextView
        android:id="@+id/tvProductTitle"
        style="@style/TextAppearance.App.Card.ProductTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="30dp"
        tools:text="Read Apple" />

    <TextView
        android:id="@+id/tvProductWeight"
        style="@style/TextAppearance.App.Card.ProductWeight.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="5dp"
        tools:text="1kg,price" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="13dp">

        <TextView
            android:id="@+id/tvProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.App.ProductPrice"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/bntAddToCartFromItemCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bntAddToCartFromItemCard"
            tools:text="4.99$" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bntAddToCartFromItemCard"
            style="@style/Widget.App.IconButton.Add"
            android:layout_marginEnd="15dp"
            android:contentDescription="@string/cd_add_to_cart"
            app:icon="@drawable/ic_add_to_cart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.966"
            app:layout_constraintStart_toEndOf="@+id/tvProductPrice"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
