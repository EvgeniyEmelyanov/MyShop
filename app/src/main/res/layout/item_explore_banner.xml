<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/exploreCardRoot"
    android:layout_width="175dp"
    android:layout_height="190dp"
    android:layout_marginVertical="15dp"
    android:layout_marginEnd="15dp"

    app:cardCornerRadius="18dp"
    app:strokeWidth="1dp"
    app:cardUseCompatPadding="false"

    tools:cardBackgroundColor="#2653B175"
    tools:strokeColor="#53B175">

    <!-- Контент карточки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="28dp"
        android:paddingBottom="15dp">

        <ImageView
            android:id="@+id/ivExploreBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            tools:src="@drawable/ic_fruits" />

        <TextView
            android:id="@+id/tvExploreBanner"
            style="@style/TextAppearance.AppCompat.TitleForExploreBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Fresh Fruits\n&amp; Vegetable" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
