<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/btnFilter"
        style="@style/Widget.App.IconButton.Filter"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/cd_filter"
        app:layout_constraintBottom_toBottomOf="@+id/tvProductGroupTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvProductGroupTitle"
        app:layout_constraintVertical_bias="0.478" />

    <ImageButton
        android:id="@+id/btnBackToFirstFragment"
        style="@style/Widget.App.IconButton.Back"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/cd_back"
        app:layout_constraintBottom_toBottomOf="@+id/tvProductGroupTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvProductGroupTitle" />

    <TextView
        android:id="@+id/tvProductGroupTitle"
        style="@style/TextAppearance.AppCompat.PageHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintEnd_toStartOf="@+id/btnFilter"
        app:layout_constraintStart_toEndOf="@+id/btnBackToFirstFragment"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_marginTop="20dp"
        tools:text="Name product" />


    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProducts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvProductGroupTitle"
        app:layout_constraintVertical_bias="1.0"
        tools:listitem="@layout/item_product_grid" />

    <include
        android:id="@+id/stateView"
        layout="@layout/view_catalog_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/rvProducts"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvProducts" />
</androidx.constraintlayout.widget.ConstraintLayout>
