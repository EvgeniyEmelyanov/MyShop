<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/groceryCardRoot"
    android:layout_width="250dp"
    android:layout_height="105dp"
    android:layout_marginEnd="15dp"
    android:background="@drawable/bg_grocery_category_card"
    android:orientation="horizontal"
    android:paddingStart="17dp"
    tools:ignore="RtlSymmetry"
    tools:layout_height="105dp"
    tools:layout_width="250dp"
    tools:backgroundTint="@color/bg_grocery_pulses"
    tools:layout_margin="20dp">


    <ImageView
        android:id="@+id/ivGroceriesPicture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@null"
        tools:srcCompat="@drawable/img_grocery_pulses">

    </ImageView>

    <TextView
        android:id="@+id/tvGroceriesTitle"
        style="@style/TextAppearance.Card.HeaderOfGroceries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="15dp"
        tools:text="@string/grocery_pulses">

    </TextView>

</LinearLayout>
